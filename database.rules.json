{
  "rules": {
    "users": {
      ".read": true,
      ".indexOn": ["username"],
      "$wallet": {
        ".write": true
      }
    },
    "usernames": {
      ".read": true,
      "$username": {
        ".write": true
      }
    },
    "chats": {
      ".read": true,
      "$wallet": {
        ".write": true
      }
    },
    "messages": {
      ".read": true,
      "$chatKey": {
        ".write": true
      }
    },
    "fcmTokens": {
      "$wallet": {
        ".read": true,
        ".write": true
      }
    },
    "presence": {
      ".read": true,
      "$wallet": {
        ".write": true
      }
    },
    "typing": {
      ".read": true,
      "$chatKey": {
        ".write": true
      }
    },
    "readReceipts": {
      ".read": true,
      "$chatKey": {
        ".write": true
      }
    },
    "online": {
      ".read": true,
      "$wallet": {
        ".write": true
      }
    }
  }
}
